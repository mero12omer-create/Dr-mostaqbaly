# انسخ هذا الملف إلى .env ثم ضع قيمك المحلية فقط.
PORT=3000
ADMIN_PASSWORD=غيّر_كلمة_مرور_الأدمن_القوية

# قاعدة البيانات (Supabase → Project Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# تخزين الملفات (Supabase → Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=ضع_secret_or_service_role_key_هنا_وليس_publishable_key
# يمكن أيضاً استخدام SUPABASE_SERVICE_ROLE_KEY بدلاً منه
SUPABASE_BUCKET=notes-files

# مزود AI متوافق مع OpenAI API
AI_API_KEY=ضع_مفتاح_AI_الجديد_هنا
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=llama-3.3-70b-versatile

# إعدادات البريد لإرسال OTP والشهادات
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@example.com
EMAIL_PASS=ضع_كلمة_مرور_التطبيق_هنا
EMAIL_FROM=your-email@example.com
